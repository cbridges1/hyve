# Used by GoReleaser (see .goreleaser.yaml `dockers_v2:`) to package the
# already cross-compiled hyve-agent binary into a multi-arch image. For a
# local build from source, use deploy/Dockerfile.agent instead.
FROM alpine:3.20

RUN apk add --no-cache ca-certificates

ARG TARGETOS
ARG TARGETARCH
COPY ${TARGETOS}/${TARGETARCH}/hyve-agent /usr/local/bin/hyve-agent

ENTRYPOINT ["hyve-agent"]
