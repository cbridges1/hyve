# Used by GoReleaser (see .goreleaser.yaml `dockers_v2:`): it cross-compiles
# the hyve binary once per platform, then packages the built binary here.
# For a local `docker build` from source, use ./Dockerfile. hyve talks to
# Kubernetes with client-go, so the image needs no kubectl or helm.
FROM alpine:3.20

RUN apk add --no-cache ca-certificates

# GoReleaser's multi-platform build stages each platform's binary under
# <os>/<arch>/ in the build context.
ARG TARGETOS
ARG TARGETARCH
COPY ${TARGETOS}/${TARGETARCH}/hyve /usr/local/bin/hyve

# The chart runs every component as non-root.
USER 65532:65532
ENTRYPOINT ["hyve"]
CMD ["--help"]
